# Base de datos (Neon, conexión pooled)
DATABASE_URL=postgresql://usuario:contraseña@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=Segundo Acto
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_SHOW_LEGAL_REVIEW_NOTES=true

# Fase 2: autenticación (JWT con cookies)
JWT_SECRET=

# Fase 2: emails (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# Fase 3: fotos (Vercel Blob) y evaluación de condición con IA
BLOB_READ_WRITE_TOKEN=
GROQ_API_KEY=
# Opcional: modelo de visión de Groq (por defecto meta-llama/llama-4-scout-17b-16e-instruct)
GROQ_VISION_MODEL=

# Fase 4: pagos (Stripe)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
